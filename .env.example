# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so the key never lands in the repository.

# Resend API key. Create one at https://resend.com/api-keys
# Real keys start with re_
RESEND_API_KEY=our_resend_api_keys

# Where form submissions are delivered.
CONTACT_TO_EMAIL=support@inversa-inc.xyz

# Optional. Investor enquiries go here instead when set.
INVESTOR_TO_EMAIL=support@inversepay.app

# The From address on outgoing mail. The domain must be verified in Resend
# (https://resend.com/domains) before Resend will send from it.
# onboarding@resend.dev works without verification but can only deliver to the
# email address that owns the Resend account, so it is for local testing only.
CONTACT_FROM_EMAIL="Inversa Website <onboarding@resend.dev>"
